__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.venv*/
dist/
build/
*.egg-info/

# Written by `assurance pin --save`; never this repo's own, and tests must not create it.
.assurance/
.mypy_cache/

# Generated by `uv run` whenever a package's tests resolve their dependencies, so a full suite
# run leaves one in every package it touched. Not a lockfile this repo publishes or pins from.
# Ignoring it stops the next broad `git add` from staging it; it does not untrack anything that
# is already tracked, and nothing is.
uv.lock
